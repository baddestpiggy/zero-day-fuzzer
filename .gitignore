# --- Secrets: never commit these ---
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# --- OS / editor ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp

# --- C++ / CMake build output ---
build/
cmake-build-*/
*.o
*.obj
*.a
*.lib
*.exe
*.out

# --- Fuzzer output (large; keep only curated crashes) ---
findings/
out/
crashes/*
!crashes/.gitkeep
